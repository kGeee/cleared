# ---- Cleared demo configuration ----
# With no QBO_/MS_ keys the app runs in OFFLINE rehearsal mode (demo data, nothing sent).
# Fill in both apps to go LIVE. Force offline anytime with: npm run offline

PORT=3000
APP_URL=http://localhost:3000

# QuickBooks Online (developer.intuit.com -> your app -> Keys & credentials, Development)
# Redirect URI to register: http://localhost:3000/auth/quickbooks/callback
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENVIRONMENT=sandbox

# Microsoft 365 / Graph (Entra ID -> App registrations)
# Redirect URI to register (platform: Web): http://localhost:3000/auth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
ONEDRIVE_ROOT=Cleared Demo

# Claude (console.anthropic.com) reads the PDFs and drafts emails. Without a key, a parser + templates are used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Where approved emails go. Use an inbox you control (open it on your phone during the demo).
# Defaults to the signed-in Microsoft account.
DEDUCTIONS_TO=
# Name shown on the audit line, e.g. "Approved by Priya"
APPROVER_NAME=You
DISPUTE_WINDOW_DAYS=30
# Minimum milliseconds per investigation step so the checks read at a human pace
STEP_MS=1000
